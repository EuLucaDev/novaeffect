<?xml version="1.0" encoding="utf-8"?>
<!--
  NovaEffect MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build novaeffect.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files (or a folder the user picks), a Start Menu shortcut and,
  unless DESKTOPSHORTCUT=0 (the wizard's "Create a desktop shortcut" box), a desktop shortcut.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="NovaEffect"
      Manufacturer="Nova Foods"
      Version="$(var.Version)"
      UpgradeCode="908987BB-F530-536C-9223-B33C2138C689"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="NovaEffect motion graphics and visual effects" Manufacturer="Nova Foods" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of NovaEffect is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- The setup wizard (installer-ui.wxs): pick the folder on a fresh install. -->
    <UIRef Id="NovaeffectUI" />

    <Icon Id="NovaeffectIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="NovaeffectIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://workflowind.agcunae.com/apps/novaeffect" />
    <Property Id="ARPURLUPDATEINFO" Value="https://workflowind.agcunae.com/apps/novaeffect" />
    <Property Id="ARPHELPLINK" Value="https://workflowind.agcunae.com/inbox" />

    <!-- An upgrade, repair or silent reinstall goes where the installed copy already is: the App Paths
         "Path" value written below, or for releases before this installer change (no Path value; they
         could be put elsewhere with INSTALLFOLDER=...) the folder of the novaeffect.exe that App Paths names. A
         "file" search with no FileSearch inside yields that file's folder. A folder passed on the
         command line (INSTALLFOLDER=...) wins. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Type="directory"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novaeffect.exe" Name="Path" />
    </Property>
    <Property Id="PREVIOUSEXEFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousExeFolder" Root="HKLM" Type="file"
          Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novaeffect.exe" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both"
        Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <SetProperty Id="INSTALLFOLDER" Action="SetINSTALLFOLDERFromExe" Value="[PREVIOUSEXEFOLDER]"
        After="SetINSTALLFOLDER" Sequence="both" Condition="PREVIOUSEXEFOLDER AND NOT INSTALLFOLDER" />

    <!-- The desktop shortcut: on by default for a fresh install (a box in the wizard, or
         DESKTOPSHORTCUT=0 silently); an upgrade keeps what the installed copy chose, and adds none
         to an install from before this option. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />
    <Property Id="PREVIOUSDESKTOPSHORTCUT" Secure="yes">
      <RegistrySearch Id="PreviousDesktopShortcut" Root="HKLM" Type="raw" Key="Software\NovaEffect" Name="DesktopShortcut" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[PREVIOUSDESKTOPSHORTCUT]" After="SetINSTALLFOLDERFromExe" Sequence="both"
        Condition="WIX_UPGRADE_DETECTED" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NovaEffect" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="NovaEffect" Level="1">
      <ComponentGroupRef Id="NovaeffectFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="NovaeffectFiles" Directory="INSTALLFOLDER">
      <Component Id="NovaeffectApp" Guid="0D4C52E0-B045-5B83-91FC-D98911B39640">
        <File Id="NovaeffectExe" Source="$(var.BinDir)\novaeffect.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="NovaEffect"
              Description="NovaEffect motion graphics and visual effects" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="NovaeffectIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novaeffect.exe" Value="[#NovaeffectExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\novaeffect.exe" Name="Path" Value="[INSTALLFOLDER]" Type="string" />
        <!-- The desktop shortcut choice, for the next upgrade (empty: none). -->
        <RegistryValue Root="HKLM" Key="Software\NovaEffect" Name="DesktopShortcut" Value="[DESKTOPSHORTCUT]" Type="string" />
      </Component>

      <Component Id="NovaeffectCli">
        <File Id="NovaeffectCliExe" Source="$(var.BinDir)\novaeffect-cli.exe" KeyPath="yes" />
      </Component>

      <!-- A component under the user's profile folders needs an HKCU key path (ICE38, ICE43). -->
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="NovaEffect" Description="NovaEffect motion graphics and visual effects"
            Target="[#NovaeffectExe]" WorkingDirectory="INSTALLFOLDER" Icon="NovaeffectIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\NovaEffect" Name="DesktopShortcut" Value="1" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="NovaFoodsLegalNotice">
        <File Id="NovaFoodsLegalNoticeFile" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
